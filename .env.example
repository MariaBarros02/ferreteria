######################################################################
# Nombre: .env.example
# Descripción: Plantilla de variables de entorno (copiar a .env). Nunca versionar .env con valores reales.
# Fecha de creación: 2026-10-07
# Fecha de actualización: 2026-10-16
# Autor: Equipo Ferretería
# Versión: 1.1.0
######################################################################
DB_USER=ferreteria
DB_PASSWORD=cambie-esta-clave
# Genere uno propio (≥ 32 caracteres), por ejemplo: openssl rand -base64 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:8081
# Solo desarrollo/pruebas: asigna esta clave a los usuarios del seed (02_seed.sql). Dejar vacío en producción.
DEMO_PASSWORD=Ferreteria2026*
# --- Comprobante de venta y parámetros de negocio (opcionales) ---
EMPRESA_NOMBRE=Ferretería
EMPRESA_NIT=
EMPRESA_DIRECCION=
EMPRESA_CIUDAD=
EMPRESA_TELEFONO=
EMPRESA_CORREO=
ZONA_HORARIA=America/Bogota
DESCUENTO_MAXIMO=10
# --- Taiga (ver scripts/taiga) ---
TAIGA_URL=https://api.taiga.io
TAIGA_USER=su-usuario-taiga
TAIGA_PASSWORD=
TAIGA_PROJECT_ID=1810232
# IDs de usuarios de Taiga a notificar (observadores), separados por coma
TAIGA_NOTIFY_IDS=764289,907661,914504
